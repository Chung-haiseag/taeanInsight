  {
   "id": "e:belongs:김행__org:taean-coastguard",
   "src_id": "person:김행",
   "rel": "belongs_to",
   "dst_id": "org:taean-coastguard",
   "attrs_json": "{\"role\":\"서장\",\"count\":5,\"confidence\":0.86,\"roles\":{\"서장\":5},\"years\":[\"1999\",\"2000\"],\"evidence\":[\"1만2천원 중국어선 또 영해침범 태안해경, 2척 나포 태안해양경찰서(서장 김행 진항으로 호송했는데 나포된 태)는 지난 8\",\"이며, 이 태안 목재 합판 상사 해상정화 캠페인 실시 태안해양경찰서 태안해양경찰서(서장 김행 어 5월 1일부터 5월 30\",\"태안해양경찰서(서장 김행 태)는 2000. 3. 17 19:35 충\"],\"sources\":[\"90013353\",\"90013978\",\"90041298\",\"90042429\",\"90042430\"]}",
